      "layer": "ETL standardization – demographics",
      "X": {"database": "omop_1", "source_table": "stg_healthcare", "source_field": "Gender", "source_value": "Male"},
      "y": {"target_table": "PERSON", "target_field": "gender_concept_id", "concept_id": 8507, "concept_name": "MALE", "vocabulary_id": "Gender", "domain_id": "Gender", "mapping_status": "mapped"}
    },
    {
