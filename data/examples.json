{
  "description": "Lab 1.2 – hand-picked (X, y) examples for the OMOP concept-mapping AI agent. X is one raw source value from one of the three thesis databases; y is the standard OMOP CDM v5.4 concept the ETL writes into the target *_concept_id column (concept_id 0 = 'No matching concept', the raw value is kept in *_source_value). Synthetic examples; no real patient data.",
  "omop_cdm_version": "5.4",
  "databases": {
    "omop_1": "Kaggle healthcare EHR dataset (staging table stg_healthcare)",
    "omop_2": "Synthea synthetic patients (CSV export)",
    "omop_3": "Lithuanian kidney-biopsy registry (Lithuanian column names and terms)"
  },
  "examples": [
